<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <!-- Extend ProductCard to show price and UoM at bottom-right -->
    <t t-name="pos_moresco_direct.ProductCard" t-inherit="point_of_sale.ProductCard" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('product-content')]" position="after">
            <div class="moresco-price-uom position-absolute bottom-0 end-0 pe-2 pb-1 text-end" style="font-size: 0.7rem; line-height: 1.1;">
                <div class="fw-bold text-muted" t-esc="formattedPrice"/>
                <div t-if="productUom" class="fst-italic text-muted" t-esc="productUom"/>
            </div>
        </xpath>
    </t>

</templates>
